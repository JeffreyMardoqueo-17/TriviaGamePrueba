@model IEnumerable<TriviaPruebaTecnica.Models.Question>
@using System.Text.Json

@{
    ViewData["Title"] = "Jugando Trivia";
    var questionsJson = JsonSerializer.Serialize(Model);
    int categoryId = Model.FirstOrDefault()?.CategoryId ?? 1;
}

<!-- Enlace directo al archivo CSS específico del juego -->
<link rel="stylesheet" href="~/css/game-play.css" asp-append-version="true" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <!-- Tarjeta principal de juego limpia y elegante -->
            <div class="card game-card border-0 p-4 p-md-5 bg-white shadow-lg" id="game-card">
                
                <!-- Barra superior: Contador de pregunta y Temporizador -->
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="game-badge-step">🎮</span>
                        <span id="question-counter" class="fw-bold text-secondary fs-6 text-uppercase tracking-wider">Pregunta 1 de 3</span>
                    </div>
                    <div id="timer-badge" class="timer-pill d-flex align-items-center gap-2 px-3 py-2 rounded-pill fw-bold text-danger bg-danger-subtle">
                        ⏳ <span id="timer-text">30s</span>
                    </div>
                </div>

                <!-- Contenedor de la Pregunta y Opciones -->
                <div id="question-container">
                    <h3 id="question-text" class="fw-extrabold mb-4 text-dark lh-sm"></h3>
                    <div id="answers-container" class="d-grid gap-3 my-4"></div>
                </div>

                <!-- Retroalimentación de respuesta -->
                <div id="feedback-container" class="mt-3 text-center fw-bold fs-5 py-2"></div>

                <!-- Pantalla de Resultados Finales -->
                <div id="result-container" class="text-center d-none py-4">
                    <div class="display-3 mb-3">🎉</div>
                    <h2 class="text-dark mb-2 fw-extrabold">¡Partida Finalizada!</h2>
                    <p class="text-muted fs-5 mb-4">Has demostrado tu conocimiento y obtenido:</p>
                    
                    <div class="score-display-box p-4 rounded-4 bg-light mx-auto mb-4 w-75 shadow-sm">
                        <span id="final-score" class="display-4 text-primary fw-extrabold">0</span>
                        <span class="text-muted d-block fs-6 fw-semibold text-uppercase mt-1">Puntos Totales</span>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                        <a href="@Url.Action("Index", "Trivia")" class="btn btn-dark btn-play-action rounded-pill px-4 py-3 fw-bold">Elegir Categoría</a>
                        <a href="@Url.Action("Leaderboard", "Trivia")" class="btn btn-primary btn-play-action rounded-pill px-4 py-3 fw-bold">Ver Ranking</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const questions = @Html.Raw(questionsJson);
        const categoryId = @categoryId;
        let currentIndex = 0;
        let score = 0;
        let correctCount = 0;
        let timer = null;
        let timeLeft = 30; // 30 segundos por pregunta

        // Carga de efectos de sonido desde wwwroot/audio/
        const soundCorrect = new Audio('/audio/correcto.wav');
        const soundIncorrect = new Audio('/audio/incorrecto.wav');
        const soundTick = new Audio('/audio/tictac.wav');
        
        // Configuramos el tictac para que se repita en bucle automáticamente
        soundTick.loop = true;

        function playSound(audioObj) {
            audioObj.currentTime = 0;
            audioObj.play().catch(e => console.log("Reproducción de audio bloqueada o archivo faltante:", e));
        }

        function stopSound(audioObj) {
            audioObj.pause();
            audioObj.currentTime = 0;
        }

        function startGame() {
            currentIndex = 0;
            score = 0;
            correctCount = 0;
            showQuestion();
        }

        function showQuestion() {
            if (currentIndex >= questions.length) {
                endGame();
                return;
            }

            clearInterval(timer);
            stopSound(soundTick); // Aseguramos detener cualquier tictac anterior

            timeLeft = 30;
            updateTimerDisplay();
            startTimer();

            const q = questions[currentIndex];
            document.getElementById('question-counter').innerText = `Pregunta ${currentIndex + 1} de ${questions.length}`;
            document.getElementById('question-text').innerText = q.QuestionText;

            const answersDiv = document.getElementById('answers-container');
            answersDiv.innerHTML = '';
            document.getElementById('feedback-container').innerText = '';

            q.Answers.forEach(ans => {
                const btn = document.createElement('button');
                btn.className = 'btn answer-option-btn text-start p-3 px-4 fs-6 fw-semibold shadow-sm';
                btn.innerText = ans.AnswerText;
                btn.onclick = () => selectAnswer(ans.IsCorrect, btn, q.Answers);
                answersDiv.appendChild(btn);
            });
        }

        function startTimer() {
            // Iniciamos el sonido del tictac en bucle para toda la duración de la pregunta
            playSound(soundTick);

            timer = setInterval(() => {
                timeLeft--;
                updateTimerDisplay();

                if (timeLeft <= 0) {
                    clearInterval(timer);
                    stopSound(soundTick); // Detenemos el tictac al acabarse el tiempo
                    handleTimeOut();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const badge = document.getElementById('timer-badge');
            const text = document.getElementById('timer-text');
            text.innerText = `${timeLeft}s`;
            
            if (timeLeft <= 10) {
                badge.className = 'timer-pill d-flex align-items-center gap-2 px-3 py-2 rounded-pill fw-bold text-warning bg-warning-subtle pulse-animation';
            } else {
                badge.className = 'timer-pill d-flex align-items-center gap-2 px-3 py-2 rounded-pill fw-bold text-danger bg-danger-subtle';
            }
        }

        function selectAnswer(isCorrect, selectedBtn, allAnswers) {
            clearInterval(timer);
            stopSound(soundTick); // se detiene cuando el usaurio respondr

            const feedback = document.getElementById('feedback-container');
            const buttons = document.getElementById('answers-container').getElementsByTagName('button');
            
            for (let b of buttons) b.disabled = true;

            if (isCorrect) {
                selectedBtn.classList.add('answer-correct');
                feedback.innerText = '✨ ¡Respuesta Correcta!';
                feedback.className = 'mt-3 text-center fw-bold fs-5 text-success animate-fade-in';
                score += 10;
                correctCount++;
                playSound(soundCorrect);
            } else {
                selectedBtn.classList.add('answer-incorrect');
                feedback.innerText = '❌ Respuesta Incorrecta';
                feedback.className = 'mt-3 text-center fw-bold fs-5 text-danger animate-fade-in';
                playSound(soundIncorrect);

                for (let i = 0; i < buttons.length; i++) {
                    if (allAnswers[i].IsCorrect) {
                        buttons[i].classList.add('answer-correct');
                    }
                }
            }

            setTimeout(() => {
                currentIndex++;
                showQuestion();
            }, 1600);
        }

        function handleTimeOut() {
            stopSound(soundTick);
            playSound(soundIncorrect);
            
            const feedback = document.getElementById('feedback-container');
            feedback.innerText = '⏰ ¡Se acabó el tiempo!';
            feedback.className = 'mt-3 text-center fw-bold fs-5 text-warning animate-fade-in';

            const buttons = document.getElementById('answers-container').getElementsByTagName('button');
            const q = questions[currentIndex];
            
            for (let i = 0; i < buttons.length; i++) {
                buttons[i].disabled = true;
                if (q.Answers[i].IsCorrect) {
                    buttons[i].classList.add('answer-correct');
                }
            }

            setTimeout(() => {
                currentIndex++;
                showQuestion();
            }, 1600);
        }

        function endGame() {
            stopSound(soundTick);
            document.getElementById('question-container').classList.add('d-none');
            document.getElementById('timer-badge').classList.add('d-none');
            document.getElementById('question-counter').classList.add('d-none');
            document.getElementById('feedback-container').classList.add('d-none');

            document.getElementById('final-score').innerText = score;
            document.getElementById('result-container').classList.remove('d-none');

            fetch('/Trivia/SaveResult', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    categoryId: categoryId,
                    pointsEarned: score,
                    correctAnswersCount: correctCount
                })
            }).catch(err => console.error("Error al guardar puntuación:", err));
        }

        startGame();
    </script>
}