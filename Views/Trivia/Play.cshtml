@model IEnumerable<TriviaPruebaTecnica.Models.Question>
@using System.Text.Json

@{
    ViewData["Title"] = "Jugando Trivia";
    var questionsJson = JsonSerializer.Serialize(Model);
    int categoryId = Model.FirstOrDefault()?.CategoryId ?? 1;
}

<!-- Enlaces a archivos CSS y JS específicos de esta vista -->
<link rel="stylesheet" href="~/css/game-play.css" asp-append-version="true" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <!-- Tarjeta principal de juego limpia y elegante -->
            <div class="card game-card border-0 p-4 p-md-5 bg-white shadow-lg" id="game-card">
                
                <!-- Barra superior: Contador de pregunta y Temporizador -->
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="game-badge-step">🎮</span>
                        <span id="question-counter" class="fw-bold text-secondary fs-6 text-uppercase tracking-wider">Pregunta 1 de 3</span>
                    </div>
                    <div id="timer-badge" class="timer-pill d-flex align-items-center gap-2 px-3 py-2 rounded-pill fw-bold text-danger bg-danger-subtle">
                        ⏳ <span id="timer-text">30s</span>
                    </div>
                </div>

                <!-- Contenedor de la Pregunta y Opciones -->
                <div id="question-container">
                    <h3 id="question-text" class="fw-extrabold mb-4 text-dark lh-sm"></h3>
                    <div id="answers-container" class="d-grid gap-3 my-4"></div>
                </div>

                <!-- Retroalimentación de respuesta -->
                <div id="feedback-container" class="mt-3 text-center fw-bold fs-5 py-2"></div>

                <!-- Pantalla de Resultados Finales -->
                <div id="result-container" class="text-center d-none py-4">
                    <div class="display-3 mb-3">🎉</div>
                    <h2 class="text-dark mb-2 fw-extrabold">¡Partida Finalizada!</h2>
                    <p class="text-muted fs-5 mb-4">Has demostrado tu conocimiento y obtenido:</p>
                    
                    <div class="score-display-box p-4 rounded-4 bg-light mx-auto mb-4 w-75 shadow-sm">
                        <span id="final-score" class="display-4 text-primary fw-extrabold">0</span>
                        <span class="text-muted d-block fs-6 fw-semibold text-uppercase mt-1">Puntos Totales</span>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                        <a href="@Url.Action("Index", "Trivia")" class="btn btn-dark btn-play-action rounded-pill px-4 py-3 fw-bold">Elegir Categoría</a>
                        <a href="@Url.Action("Leaderboard", "Trivia")" class="btn btn-primary btn-play-action rounded-pill px-4 py-3 fw-bold">Ver Ranking</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de Advertencia de Partida en Curso -->
<div class="modal fade" id="leaveGameModal" tabindex="-1" aria-labelledby="leaveGameModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-extrabold text-dark d-flex align-items-center gap-2" id="leaveGameModalLabel">
                    ⚠️ ¿Estás seguro de abandonar la partida?
                </h5>
            </div>
            <div class="modal-body text-muted py-3">
                Si sales ahora, perderás el progreso actual de tu juego en curso. Te recomendamos terminar las preguntas.
            </div>
            <div class="modal-footer border-0 pt-0 d-flex gap-2">
                <!-- Botón de Continuar (Prioritario / Resaltado) -->
                <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold flex-grow-1 shadow-sm" data-bs-dismiss="modal">
                    🎮 Continuar Jugando
                </button>
                <!-- Botón de Finalizar / Salir -->
                <button type="button" id="confirm-leave-btn" class="btn btn-outline-danger rounded-pill px-4 py-2 fw-bold">
                    Sí, finalizar juego
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        window.triviaQuestions = @Html.Raw(questionsJson);
        window.triviaCategoryId = @categoryId;
    </script>
    <script src="~/js/game.js" asp-append-version="true"></script>

    <!-- Script de protección y pausa de partida 100% compatible con Móvil y Escritorio -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let targetUrl = "";
            const leaveModalElement = document.getElementById('leaveGameModal');
            
            if (!leaveModalElement) return;
            
            const leaveModal = new bootstrap.Modal(leaveModalElement);
            const confirmLeaveBtn = document.getElementById('confirm-leave-btn');
            const continueGameBtn = leaveModalElement.querySelector('[data-bs-dismiss="modal"]');

            function isGameActive() {
                const resultContainer = document.getElementById('result-container');
                return resultContainer && resultContainer.classList.contains('d-none');
            }

            // Función centralizada para manejar el intento de salida (compatible con PC y Celular)
            function handlePotentialExit(e, link) {
                if (!isGameActive()) return;

                // Permitir botones internos del juego o clics dentro del menú móvil sin disparar advertencia
                if (link.closest('#answers-container') || link.classList.contains('game-internal-btn') || link.closest('#mobileNavbarOffcanvas')) {
                    return;
                }

                let href = null;
                let isFormButton = false;
                let formTarget = null;

                if (link.tagName === 'A' && link.getAttribute('href')) {
                    href = link.getAttribute('href');
                } else if (link.tagName === 'BUTTON' && link.closest('form')) {
                    isFormButton = true;
                    formTarget = link.closest('form');
                }

                if ((href && href !== '#' && !href.startsWith('javascript')) || isFormButton) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (isFormButton) {
                        targetUrl = () => {
                            sessionStorage.removeItem(`trivia_game_state_${window.triviaCategoryId || 1}`);
                            formTarget.submit();
                        };
                    } else {
                        targetUrl = href;
                    }

                    // PAUSAR EL JUEGO Y EL CRONÓMETRO INMEDIATAMENTE (Móvil y Escritorio)
                    if (window.triviaGame && typeof window.triviaGame.pause === 'function') {
                        window.triviaGame.pause();
                    }

                    // Forzar la apertura del modal en dispositivos móviles de forma segura
                    leaveModal.show();
                }
            }

            // Escuchar tanto clics de escritorio como toques en pantallas táctiles de celulares
            document.addEventListener('click', function (e) {
                const link = e.target.closest('a, button[type="submit"]');
                if (link) {
                    handlePotentialExit(e, link);
                }
            }, true); // Usar captura para adelantarnos a cualquier otro script móvil

            // Botón Continuar Jugando: Reanuda el cronómetro exactamente donde iba
            if (continueGameBtn) {
                continueGameBtn.addEventListener('click', function () {
                    if (window.triviaGame && typeof window.triviaGame.resume === 'function') {
                        window.triviaGame.resume();
                    }
                });
            }

            // Botón Confirmar Salida: Borra la sesión y redirige
            if (confirmLeaveBtn) {
                confirmLeaveBtn.addEventListener('click', function () {
                    leaveModal.hide();
                    sessionStorage.removeItem(`trivia_game_state_${window.triviaCategoryId || 1}`);
                    if (typeof targetUrl === 'function') {
                        targetUrl();
                    } else if (targetUrl) {
                        window.location.href = targetUrl;
                    }
                });
            }
        });
    </script>
}