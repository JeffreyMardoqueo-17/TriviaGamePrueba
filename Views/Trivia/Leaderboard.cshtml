@model IEnumerable<TriviaPruebaTecnica.Models.LeaderboardEntry>

@{
    ViewData["Title"] = "Tablero de Posiciones";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow border-0 p-4">
                <h2 class="text-center fw-bold mb-4 text-primary"> Tablero de Posiciones</h2>
                <p class="text-center text-muted mb-4">Ranking de usuarios con mayor puntaje acumulado en la plataforma.</p>

                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center">
                        <thead class="table-dark">
                            <tr>
                                <th>Posición</th>
                                <th>Usuario</th>
                                <th>Puntos Totales</th>
                                <th>Partidas</th>
                                <th>Aciertos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var entry in Model)
                                {
                                    <tr>
                                        <td class="fw-bold fs-5">
                                            @if (entry.RankPosition == 1) { <span>🥇 1</span> }
                                            else if (entry.RankPosition == 2) { <span>🥈 2</span> }
                                            else if (entry.RankPosition == 3) { <span>🥉 3</span> }
                                            else { <span>@entry.RankPosition</span> }
                                        </td>
                                        <td class="fw-semibold text-start">@entry.Username</td>
                                        <td class="text-success fw-bold fs-5">@entry.TotalPoints pts</td>
                                        <td>@entry.GamesPlayed</td>
                                        <td>@entry.CorrectAnswers</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-muted py-4">Aún no hay partidas registradas en el ranking. ¡Sé el primero!</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-center mt-4">
                    <a href="@Url.Action("Index", "Trivia")" class="btn btn-dark rounded-pill px-5">
                        Volver al Menú 
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>