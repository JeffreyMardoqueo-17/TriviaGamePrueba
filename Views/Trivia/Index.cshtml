@model IEnumerable<TriviaPruebaTecnica.Models.Category>

@{
    ViewData["Title"] = "Seleccionar Categoría - Trivia";
}

<!-- Enlace directo al CSS específico de esta vista (sin usar secciones) -->
<link rel="stylesheet" href="~/css/category-select.css" asp-append-version="true" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 text-center">
            <h2 class="fw-bold mb-2 display-6 text-dark">¡Bienvenido a la Trivia!</h2>
            <p class="text-muted mb-5 fs-5">Selecciona una categoría para comenzar el desafío:</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger shadow-sm rounded-4">@TempData["Error"]</div>
            }

            <div class="row g-4 justify-content-center">
                @foreach (var category in Model)
                {
                    <div class="col-md-5 col-lg-4">
                        <div class="card h-100 category-card shadow-sm border-0 rounded-4 p-3 bg-white">
                            <div class="card-body d-flex flex-column justify-content-between text-center p-3">
                                <div>
                                    <!-- Contenedor del ícono -->
                                    <div class="icon-box mx-auto mb-4 rounded-4 d-flex align-items-center justify-content-center shadow-sm">
                                        @if (category.Name.Contains("Animales", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="fs-2">🐾</span>
                                        }
                                        else if (category.Name.Contains("Carros", StringComparison.OrdinalIgnoreCase) || category.Name.Contains("Vehículos", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="fs-2">🚗</span>
                                        }
                                        else
                                        {
                                            <span class="fs-2">💡</span>
                                        }
                                    </div>

                                    <h4 class="card-title fw-bold text-primary mb-3">@category.Name</h4>
                                    <p class="card-text text-muted small px-2 mb-4">@category.Description</p>
                                </div>

                                <a asp-action="Play" asp-route-categoryId="@category.Id" class="btn btn-dark w-100 py-3 rounded-pill fw-semibold shadow-sm text-uppercase tracking-wider btn-play">
                                    Jugar Ahora
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>