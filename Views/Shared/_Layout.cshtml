<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TriviaPruebaTecnica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TriviaPruebaTecnica.styles.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3 py-3">
                <div class="container-fluid px-4">
                    
                    <!-- Logo -->
                    <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Trivia" asp-action="Index">
                        <div class="bg-primary text-white d-flex align-items-center justify-content-center rounded-3 shadow-sm" style="width: 40px; height: 40px;">
                            🧠
                        </div>
                        <span class="fw-bold fs-5 text-dark">Trivia<span class="text-primary">PruebaTecnica</span></span>
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        
                        <!-- Menú central estilo píldora -->
                        <ul class="navbar-nav mx-auto">
                            <li class="nav-item nav-pill-container border rounded-pill p-1 d-flex gap-1 shadow-sm">
                                <a class="nav-link fw-semibold px-3 py-2 rounded-pill d-flex align-items-center gap-1 @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active-tab" : "text-secondary")" 
                                   asp-controller="Trivia" asp-action="Index">
                                    🎮 Jugar
                                </a>
                                <a class="nav-link fw-semibold px-3 py-2 rounded-pill d-flex align-items-center gap-1 @(ViewContext.RouteData.Values["action"]?.ToString() == "Leaderboard" ? "active-tab" : "text-secondary")" 
                                   asp-controller="Trivia" asp-action="Leaderboard">
                                    🏆 Tablero de Posiciones
                                </a>
                            </li>
                        </ul>

                        <!-- Menú derecho -->
                        <ul class="navbar-nav align-items-center gap-2">
                            <li class="nav-item">
                                <span class="nav-link bg-light border text-secondary fw-semibold rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                                    👤 @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="User" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-3 py-2 shadow-sm fw-semibold d-flex align-items-center gap-1">
                                        🚪 Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        </ul>

                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3">
        <div class="container">
            &copy; 2026 - TriviaPruebaTecnica
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>