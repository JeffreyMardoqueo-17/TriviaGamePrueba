<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TriviaPruebaTecnica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TriviaPruebaTecnica.styles.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userPoints = User.FindFirst("TotalPoints")?.Value ?? "0";

        <header class="sticky-top">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2 shadow-sm position-relative">
                <div class="container-fluid px-4">
                    
                    <a class="navbar-brand d-flex align-items-center gap-2 m-0 p-0 text-decoration-none"
                       asp-controller="Trivia" asp-action="Index">
                        <div class="d-flex align-items-center justify-content-center btn-action  text-white rounded-3 shadow-sm"
                             style="width: 38px; height: 38px; font-size: 1.1rem;">
                            <i class="bi bi-controller"></i>
                        </div>
                        <div class="d-flex flex-column">
                            <span class="fw-bold text-dark lh-1" style="font-size: 0.95rem;">Trivia<span
                                class="text-primary">PruebaTecnica</span></span>
                            </div>
                        </a>

                        <button class="navbar-toggler border-0 shadow-none p-2 rounded-3 bg-light d-lg-none ms-auto"
                                type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavbarOffcanvas"
                                aria-controls="mobileNavbarOffcanvas">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="d-none d-lg-flex align-items-center gap-2 position-absolute start-50 translate-middle-x">
                            <a class="btn rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "btn-primary shadow-sm" : "btn-light text-secondary")"
                               asp-controller="Trivia" asp-action="Index" style="font-size: 0.85rem;">
                                <i class="bi bi-play-circle-fill"></i> Jugar
                            </a>
                            <a class="btn rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Leaderboard" ? "btn-primary shadow-sm" : "btn-light text-secondary")"
                               asp-controller="Trivia" asp-action="Leaderboard" style="font-size: 0.85rem;">
                                <i class="bi bi-trophy-fill"></i> Leaderboard
                            </a>
                        </div>

                        <div class="d-none d-lg-flex align-items-center gap-2 ms-auto">
                            <!-- Puntos -->
                            <div class="d-flex align-items-center gap-2 bg-light border px-3 py-1 rounded-pill shadow-sm">
                                <i class="bi bi-coin text-warning fs-5"></i>
                                <div class="d-flex flex-column lh-1">
                                    <span class="text-muted" style="font-size: 0.55rem; font-weight: 800;">PUNTOS</span>
                                    <span class="fw-bold text-success" style="font-size: 0.8rem;">@userPoints pts</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 bg-light border px-3 py-1 rounded-pill shadow-sm">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                     style="width: 26px; height: 26px; font-size: 0.75rem;">
                                    @User.Identity.Name?.Substring(0, 1).ToUpper()
                                </div>
                                <span class="fw-bold text-dark text-truncate"
                                      style="font-size: 0.8rem; max-width: 100px;">@User.Identity.Name</span>
                            </div>

                            <form asp-controller="User" asp-action="Logout" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-outline-danger rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm"
                                        style="width: 34px; height: 34px;" title="Cerrar Sesión">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </form>
                        </div>

                        <div class="offcanvas offcanvas-end d-lg-none mobile-arcade-offcanvas" tabindex="-1"
                             id="mobileNavbarOffcanvas" aria-labelledby="mobileNavbarOffcanvasLabel">
                            <div class="offcanvas-header border-bottom px-4 py-3 bg-white">
                                <h5 class="offcanvas-title fw-bold text-dark d-flex align-items-center gap-2"
                                    id="mobileNavbarOffcanvasLabel">
                                    <div class="d-flex align-items-center justify-content-center bg-primary text-white rounded-2"
                                         style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <i class="bi bi-controller"></i>
                                    </div>
                                    Menú
                                </h5>
                                <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas"
                                        aria-label="Close"></button>
                            </div>
                            <div class="offcanvas-body px-4 py-4 d-flex flex-column justify-content-between bg-white">
                                <div>
                                    <div class="mb-4 p-3 bg-light rounded-4 border shadow-sm">
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 36px; height: 36px; font-size: 0.85rem;">
                                                @User.Identity.Name?.Substring(0, 1).ToUpper()
                                            </div>
                                            <div class="text-break">
                                                <small class="text-muted d-block text-uppercase fw-bold"
                                                       style="font-size: 0.55rem;">Jugador</small>
                                                <span class="fw-bold text-dark fs-6">@User.Identity.Name</span>
                                            </div>
                                        </div>
                                        <div
                                            class="bg-white p-2 rounded-3 border d-flex align-items-center justify-content-between shadow-sm">
                                            <span class="text-muted small fw-semibold"><i
                                                class="bi bi-coin text-warning me-1"></i> Puntos:</span>
                                                <span class="fw-bold text-success">@userPoints pts</span>
                                            </div>
                                        </div>

                                        <div class="list-group list-group-flush gap-2">
                                            <a class="list-group-item list-group-item-action rounded-3 py-3 px-3 fw-bold d-flex align-items-center gap-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "bg-primary text-white shadow-sm" : "text-dark bg-light")"
                                               asp-controller="Trivia" asp-action="Index">
                                                <i
                                                class="bi bi-play-circle-fill fs-5 @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-white" : "text-primary")"></i>
                                                Jugar
                                            </a>
                                            <a class="list-group-item list-group-item-action rounded-3 py-3 px-3 fw-bold d-flex align-items-center gap-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Leaderboard" ? "bg-primary text-white shadow-sm" : "text-dark bg-light")"
                                               asp-controller="Trivia" asp-action="Leaderboard">
                                                <i
                                                class="bi bi-trophy-fill fs-5 @(ViewContext.RouteData.Values["action"]?.ToString() == "Leaderboard" ? "text-white" : "text-warning")"></i>
                                                Leaderboard
                                            </a>
                                        </div>
                                    </div>

                                    <div class="pt-3 border-top mt-4">
                                        <form asp-controller="User" asp-action="Logout" method="post" class="w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-outline-danger w-100 rounded-pill py-3 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </nav>
                </header>
            }
    
            <div class="page-wrapper">
                <main role="main" class="content-area container my-4">
                    @RenderBody()
                </main>
            </div>

            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>